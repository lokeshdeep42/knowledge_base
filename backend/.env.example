# Optional: without OPENAI_API_KEY /query returns retrieved sources only (answer: null).
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible API (OpenRouter, Ollama: http://localhost:11434/v1)
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

DATABASE_PATH=data/inbox.db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MIN_SCORE=0.5
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Optional: URL or email for the fetcher's User-Agent; Wikipedia returns 403 without one.
FETCH_CONTACT=
